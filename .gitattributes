# Auto detect text files and normalize line endings
* text=auto

# Explicitly declare text files
*.py text
*.md text
*.txt text
*.html text
*.yaml text
*.yml text
*.json text

# Treat these as binary (do not attempt line-ending normalization / diffs)
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Track large trained model file with Git LFS (optional but recommended
# if model.pkl grows beyond a few MB)
model.pkl filter=lfs diff=lfs merge=lfs -text
